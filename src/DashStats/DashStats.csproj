<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DashStats</AssemblyName>
    <RootNamespace>DashStats</RootNamespace>
    <Version>0.3.1</Version>
    <!-- Shown in the exe's Properties → Details; code signing requires these to be set and consistent. -->
    <Product>DashStats</Product>
    <AssemblyTitle>DashStats</AssemblyTitle>
    <Description>DashStats PC health widget</Description>
    <Company>Varazi</Company>
    <Authors>Varazi</Authors>
    <Copyright>Copyright © 2026 Varazi. MIT License.</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003: DPI awareness is declared in the manifest on purpose (WPF owns the window). -->
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054;WFO0003</NoWarn>

    <!-- One self-contained exe: the target PC needs nothing pre-installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Uncompressed so the runtime is memory-mapped from disk instead of unpacked into RAM. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>

    <!-- Keep the footprint small. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon and screen info; avoid name clashes with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\vendor\PresentMon.exe" LogicalName="PresentMon.exe" />
    <EmbeddedResource Include="..\..\vendor\PawnIO_setup.exe" LogicalName="PawnIO_setup.exe" />
  </ItemGroup>

</Project>
